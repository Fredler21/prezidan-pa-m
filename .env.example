# Copy to .env.local for local development.

# Backend: "firebase" (default) or "local" (demo mode, votes stay in this browser).
VITE_STORAGE=firebase

# One-vote-per-person check: "anonymous" (default, Firebase Anonymous Auth) or
# "phone" (SMS OTP via Firebase Phone Auth — enable the provider; non-free regions need Blaze).
VITE_AUTH=anonymous
